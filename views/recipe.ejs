<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= recipe.name %> — Recipe Tracker</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <a href="/" class="brand">
        <div class="brand-mark">🍳</div>
        <div>
          <h1>Recipe Tracker</h1>
        </div>
      </a>
      <a href="/" class="btn btn-outline-light">← Back to Recipes</a>
    </div>
  </header>

  <main class="page recipe-detail-page">
    <div class="recipe-detail-card">
      <h1 class="recipe-detail-title"><%= recipe.name %></h1>

      <div class="recipe-detail-meta">
        <% if (recipe.tags && recipe.tags.length > 0) { %>
          <div class="tags">
            <% recipe.tags.forEach(tag => { %>
              <a href="/?q=<%= encodeURIComponent(tag) %>" class="tag tag-link" title="Search recipes tagged “<%= tag %>”"><%= tag %></a>
            <% }) %>
          </div>
        <% } %>
        <a href="<%= recipe.url %>" target="_blank" rel="noopener noreferrer" class="recipe-source-link">🔗 View original recipe</a>
      </div>

      <% if (recipe.review) { %>
        <div class="recipe-detail-review">
          <span class="review-label">Review:</span>
          <span class="review-text">"<%- md.inline(recipe.review) %>"</span>
        </div>
      <% } %>

      <h2 class="recipe-detail-section-title">📖 Full Recipe</h2>
      <div class="recipe-detail-body markdown-body"><%- md.render(recipe.body) %></div>

      <div class="recipe-detail-actions">
        <a href="/recipes/<%= recipe._id %>/edit" class="btn btn-outline">✏️ Edit</a>
        <form action="/recipes/<%= recipe._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Delete this recipe?');">
          <button type="submit" class="btn btn-danger">🗑 Delete</button>
        </form>
      </div>
    </div>
  </main>

  <footer class="footer">
    <p>🍳 Recipe Tracker: save, review, and organize your favorite recipes</p>
  </footer>
</body>
</html>