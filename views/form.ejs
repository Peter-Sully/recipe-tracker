<!DOCTYPE html>
<html>
<head>
  <title><%= recipe ? 'Edit Recipe' : 'Add Recipe' %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <h1><%= recipe ? 'Edit Recipe' : 'Add New Recipe' %></h1>
    <a href="/" class="button">← Back</a>
    <% if (recipe) { %>
      <form action="/recipes-form/<%= recipe._id %>?_method=PUT" method="POST">
    <% } else { %>
      <form action="/recipes-form" method="POST">
    <% } %>
    <label for="name">Recipe Name</label><br />
    <input id="name" name="name" value="<%= recipe ? recipe.name : '' %>" required /><br /><br />
    <label for="url">Recipe URL</label><br />
    <input id="url" name="url" value="<%= recipe ? recipe.url : '' %>" required /><br /><br />
    <label for="body">Full Recipe</label><br />
    <textarea id="body" name="body" required rows="6" cols="50"><%= recipe ? recipe.body : '' %></textarea><br /><br />
    <label for="review">Your Review</label><br />
    <textarea id="review" name="review" rows="3" cols="50"><%= recipe ? recipe.review : '' %></textarea><br /><br />
    <label for="tags">Tags (comma-separated)</label><br />
    <input id="tags" name="tags" value="<%= recipe ? recipe.tags.join(', ') : '' %>" /><br /><br />
    <button type="submit">💾 Save</button>
    </form>

</body>
</html>