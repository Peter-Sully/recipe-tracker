<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= recipe ? 'Edit Recipe' : 'Add Recipe' %> — Recipe Tracker</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <a href="/" class="brand">
        <div class="brand-mark">🍳</div>
        <div>
          <h1>Recipe Tracker</h1>
        </div>
      </a>
      <a href="/" class="btn btn-outline-light">← Back to Recipes</a>
    </div>
  </header>

  <main class="page form-page">
    <div class="form-header">
      <h1><%= recipe ? '✏️ Edit Recipe' : '➕ Add New Recipe' %></h1>
    </div>

    <div class="form-card">
      <% if (recipe) { %>
        <form action="/recipes-form/<%= recipe._id %>?_method=PUT" method="POST">
      <% } else { %>
        <form action="/recipes-form" method="POST">
      <% } %>

        <div class="form-group">
          <label for="name">Recipe Name</label>
          <input id="name" name="name" value="<%= recipe ? recipe.name : '' %>" placeholder="e.g. Grandma's Banana Bread" required />
        </div>

        <div class="form-group">
          <label for="url">Recipe URL <span class="hint">(link to the original recipe)</span></label>
          <input id="url" name="url" value="<%= recipe ? recipe.url : '' %>" placeholder="https://example.com/recipe" type="url" />
        </div>

        <div class="form-group">
          <label for="body">Full Recipe <span class="hint">(Markdown supported — **bold**, *italic*, [links](https://...))</span></label>
          <div class="md-editor" data-md-editor>
            <div class="md-toolbar">
              <button type="button" class="md-btn" data-md="bold" title="Bold (Ctrl+B)">B</button>
              <button type="button" class="md-btn" data-md="italic" title="Italic (Ctrl+I)">I</button>
              <button type="button" class="md-btn" data-md="h1" title="Heading 1 (#)">H1</button>
              <button type="button" class="md-btn" data-md="h2" title="Heading 2 (##)">H2</button>
              <button type="button" class="md-btn" data-md="ul" title="Bulleted list (- )">• List</button>
              <button type="button" class="md-btn" data-md="ol" title="Numbered list (1. )">1. List</button>
              <button type="button" class="md-btn" data-md="quote" title="Quote (> )">❝</button>
              <button type="button" class="md-btn" data-md="link" title="Insert link">🔗</button>
              <button type="button" class="md-btn" data-md="code" title="Inline code (`)">`</button>
              <span class="md-spacer"></span>
              <div class="md-tabs">
                <button type="button" class="md-tab is-active" data-md-view="write" aria-pressed="true">✍️ Write</button>
                <button type="button" class="md-tab" data-md-view="preview" aria-pressed="false">👁 Preview</button>
              </div>
            </div>
            <textarea id="body" name="body" rows="8" placeholder="Ingredients and instructions... (Markdown supported)" required><%= recipe ? recipe.body : '' %></textarea>
            <div class="md-preview markdown-body" hidden></div>
          </div>
        </div>

        <div class="form-group">
          <label for="review">Your Review <span class="hint">(optional · Markdown supported)</span></label>
          <div class="md-editor" data-md-editor>
            <div class="md-toolbar">
              <button type="button" class="md-btn" data-md="bold" title="Bold (Ctrl+B)">B</button>
              <button type="button" class="md-btn" data-md="italic" title="Italic (Ctrl+I)">I</button>
              <button type="button" class="md-btn" data-md="h1" title="Heading 1 (#)">H1</button>
              <button type="button" class="md-btn" data-md="h2" title="Heading 2 (##)">H2</button>
              <button type="button" class="md-btn" data-md="ul" title="Bulleted list (- )">• List</button>
              <button type="button" class="md-btn" data-md="ol" title="Numbered list (1. )">1. List</button>
              <button type="button" class="md-btn" data-md="quote" title="Quote (> )">❝</button>
              <button type="button" class="md-btn" data-md="link" title="Insert link">🔗</button>
              <button type="button" class="md-btn" data-md="code" title="Inline code (`)">`</button>
              <span class="md-spacer"></span>
              <div class="md-tabs">
                <button type="button" class="md-tab is-active" data-md-view="write" aria-pressed="true">✍️ Write</button>
                <button type="button" class="md-tab" data-md-view="preview" aria-pressed="false">👁 Preview</button>
              </div>
            </div>
            <textarea id="review" name="review" rows="3" placeholder="What did you think? How did it turn out? (Markdown supported)"><%= recipe ? recipe.review : '' %></textarea>
            <div class="md-preview markdown-body" hidden></div>
          </div>
        </div>

        <div class="form-group">
          <label for="tags">Tags <span class="hint">(comma-separated)</span></label>
          <input id="tags" name="tags" value="<%= recipe ? recipe.tags.join(', ') : '' %>" placeholder="e.g. dessert, easy, vegetarian" />
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-lg">💾 Save Recipe</button>
          <a href="/" class="btn btn-outline">Cancel</a>
        </div>
      </form>
    </div>
  </main>

  <footer class="footer">
    <p>🍳 Recipe Tracker: save, review, and organize your favorite recipes</p>
  </footer>

  <script src="/js/markdown.js"></script>
  <script src="/js/text-format.js"></script>
  <script src="/js/editor.js"></script>
</body>
</html>