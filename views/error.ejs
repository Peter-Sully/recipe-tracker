<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Error <%= status %> — Recipe Tracker</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <a href="/" class="brand">
        <div class="brand-mark">🍳</div>
        <div>
          <h1>Recipe Tracker</h1>
        </div>
      </a>
    </div>
  </header>

  <main class="page error-page">
    <div class="error-card">
      <span class="error-emoji animate-bounce">😕</span>
      <div class="error-code"><%= status %></div>
      <h1>Oops! Something went wrong.</h1>
      <p class="error-message"><%= message %></p>
      <a href="/" class="btn btn-primary btn-lg">← Back to Home</a>
      <p class="error-quote">"Every failed dish teaches you something new."</p>
    </div>
  </main>

  <footer class="footer">
    <p>🍳 Recipe Tracker: save, review, and organize your favorite recipes</p>
  </footer>
</body>
</html>