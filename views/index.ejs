<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Recipe Tracker</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <a href="/" class="brand">
        <div class="brand-mark">🍳</div>
        <div>
          <h1>Recipe Tracker</h1>
        </div>
      </a>
      <a href="/new" class="btn btn-accent">➕ Add New Recipe</a>
    </div>
  </header>

  <main class="page">
    <form action="/" method="GET" class="search-form" role="search">
      <div class="search-box">
        <input
          type="search"
          name="q"
          value="<%= query %>"
          placeholder="Search by name, tag, or keyword…"
          aria-label="Search recipes by name, tag, or keyword"
          autocomplete="off"
        />
        <button type="submit" class="btn btn-primary">🔍 <span>Search</span></button>
      </div>
      <% if (query) { %>
        <a href="/" class="search-clear" title="Clear search">✕ Clear search</a>
      <% } %>
    </form>

    <% if (recipes.length === 0) { %>
      <% if (query) { %>
        <div class="empty-state">
          <span class="empty-emoji">🔍</span>
          <h2>No results for “<%= query %>”</h2>
          <p>Nothing matched your search. Try a different name, tag, or keyword.</p>
          <a href="/" class="btn btn-primary btn-lg">← Browse All Recipes</a>
        </div>
      <% } else { %>
        <div class="empty-state">
          <span class="empty-emoji">🍽️</span>
          <h2>No recipes yet</h2>
          <p>Your cookbook is empty. Add your first recipe to start building your personal collection.</p>
          <a href="/new" class="btn btn-primary btn-lg">➕ Add Your First Recipe</a>
        </div>
      <% } %>
    <% } else { %>
      <div class="section-title">
        <% if (query) { %>
          <h2>Results for “<%= query %>”</h2>
          <span class="count"><%= recipes.length %> match<%= recipes.length !== 1 ? 'es' : '' %></span>
        <% } else { %>
          <h2>Your Recipes</h2>
          <span class="count"><%= recipes.length %> recipe<%= recipes.length !== 1 ? 's' : '' %></span>
        <% } %>
      </div>

      <div class="recipe-grid">
        <% recipes.forEach(r => { %>
          <article class="recipe-card">
            <div class="recipe-card-top">
              <h3><a href="/recipes/<%= r._id %>"><%= r.name %></a></h3>
            </div>

            <div class="recipe-body"><%- md.render(r.body) %></div>

            <% if (r.review) { %>
              <div class="review">
                <span class="review-label">Review:</span>
                <span class="review-text">"<%- md.inline(r.review) %>"</span>
              </div>
            <% } %>
            
              <div class="recipe-source">
                <% if (r.url) { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
                <a href="<%= r.url %>" target="_blank" rel="noopener noreferrer"><%= r.url %></a>
                <% } %>
              </div>
            
            <% if (r.tags && r.tags.length > 0) { %>
              <div class="tags">
                <% r.tags.forEach(tag => { %>
                  <a href="/?q=<%= encodeURIComponent(tag) %>" class="tag tag-link" title="Search recipes tagged “<%= tag %>”"><%= tag %></a>
                <% }) %>
              </div>
            <% } %>

            <div class="card-actions">
              <a href="/recipes/<%= r._id %>/edit" class="btn btn-outline btn-sm">✏️ Edit</a>
              <form action="/recipes/<%= r._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Delete this recipe?');">
                <button type="submit" class="btn btn-danger btn-sm">🗑️ Delete</button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>

  <footer class="footer">
    <p>🍳 Recipe Tracker: save, review, and organize your favorite recipes</p>
  </footer>
</body>
</html>