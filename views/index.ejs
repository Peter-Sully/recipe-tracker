<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Recipe Tracker</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <div class="brand">
        <div class="brand-mark">🍳</div>
        <div>
          <h1>Recipe Tracker</h1>
          
        </div>
      </div>
      <a href="/new" class="btn btn-accent">➕ Add New Recipe</a>
    </div>
  </header>

  <main class="page">
    <% if (recipes.length === 0) { %>
      <div class="empty-state">
        <span class="empty-emoji">🍽️</span>
        <h2>No recipes yet</h2>
        <p>Your cookbook is empty. Add your first recipe to start building your personal collection.</p>
        <a href="/new" class="btn btn-primary btn-lg">➕ Add Your First Recipe</a>
      </div>
    <% } else { %>
      <div class="section-title">
        <h2>Your Recipes</h2>
        <span class="count"><%= recipes.length %> recipe<%= recipes.length !== 1 ? 's' : '' %></span>
      </div>

      <div class="recipe-grid">
        <% recipes.forEach(r => { %>
          <article class="recipe-card">
            <div class="recipe-card-top">
              <h3><a href="/recipes/<%= r._id %>"><%= r.name %></a></h3>
            </div>

            <div class="recipe-body"><%= r.body %></div>

            <% if (r.review) { %>
              <div class="review">
                <span class="review-label">Review:</span>
                <span class="review-text">"<%= r.review %>"</span>
              </div>
            <% } %>

            <div class="recipe-source">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
              <a href="<%= r.url %>" target="_blank" rel="noopener noreferrer"><%= r.url %></a>
            </div>

            <% if (r.tags && r.tags.length > 0) { %>
              <div class="tags">
                <% r.tags.forEach(tag => { %>
                  <span class="tag"><%= tag %></span>
                <% }) %>
              </div>
            <% } %>

            <div class="card-actions">
              <a href="/recipes/<%= r._id %>/edit" class="btn btn-outline btn-sm">✏️ Edit</a>
              <form action="/recipes/<%= r._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Delete this recipe?');">
                <button type="submit" class="btn btn-danger btn-sm">🗑 Delete</button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>

  <footer class="footer">
    <p>🍳 Recipe Tracker: save, review, and organize your favorite recipes</p>
  </footer>
</body>
</html>