<!DOCTYPE html>
<html>
<head>
  <title>Recipe Tracker</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <h1>Recipe Tracker</h1>
  <a href="/new" class="button">➕ Add New Recipe</a>

  <% recipes.forEach(r => { %>
    <div class="recipe-card">
      <h2><%= r.name %></h2>
      <p><a href="<%= r.url %>" target="_blank"><%= r.url %></a></p>
      <pre><%= r.body %></pre>
      <p><strong>Review:</strong> <%= r.review %></p>
      <p><strong>Tags:</strong> <%= r.tags.join(', ') %></p>
      <a href="/recipes/<%= r._id %>/edit" class="button">✏️ Edit</a>
      <form action="/recipes/<%= r._id %>?_method=DELETE" method="POST" class="delete-form">
        <button type="submit">🗑 Delete</button>
      </form>
    </div>
  <% }) %>

  </ul>
</body>
</html>
